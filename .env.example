# =====================================================================
# 环境变量配置 —— 复制本文件为 .env 后填写
#   copy .env.example .env
#
# 【国内推荐组合】对话用 DeepSeek，向量用硅基流动（都有免费/低价额度）
#   DeepSeek 控制台：  https://platform.deepseek.com  （注册→充值几块钱→创建 API Key）
#   硅基流动控制台：   https://cloud.siliconflow.cn   （注册→免费额度→创建 API Key，bge-m3 免费）
# 两家都是 OpenAI 兼容协议，代码不用改，只改下面配置。
# =====================================================================

# ===== 对话大模型（必填）=====
LLM_API_KEY=sk-在这里填DeepSeek的key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 向量化模型（必填；与对话模型可不同服务商）=====
# 硅基流动 BAAI/bge-m3：中日英多语言效果好，1024 维（做日本站选日语/中文检索都合适）
LLM_EMBEDDING_API_KEY=sk-在这里填硅基流动的key
LLM_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
LLM_EMBEDDING_MODEL=BAAI/bge-m3

# ===== Milvus 向量库（第四步才用到，第一步可先不动）=====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=tiktok_product
# 维度必须和向量模型一致：bge-m3=1024；OpenAI text-embedding-3-small=1536
MILVUS_EMBEDDING_DIM=1024

# ===== 检索后端（第四步）：一套接口，三种实现可切换 =====
# memory = 纯内存余弦检索（免安装，离线跑测试/演示；重启即清空）
# milvus  = 自建 Milvus（docker compose up -d milvus；细粒度切片，生产首选）
# ragflow = 托管 RAGFlow（自带解析/混合检索；上传后代码会自动触发解析）
RAG_BACKEND=milvus
# 仅 RAG_BACKEND=ragflow 时需要（RAGFlow 头像 → API Key；地址不带尾斜杠）
RAG_BASE_URL=http://localhost
RAG_API_KEY=
RAG_DATASET=tiktok_bedding_kb
# 混合检索：相似度阈值（RAGFlow 口径通常 0.2 起）与向量权重（0~1，其余给关键词）
RAG_SIMILARITY_THRESHOLD=0.2
RAG_VECTOR_WEIGHT=0.3

# ===== 采集数据源（可插拔，第三步）=====
# 商品数据源：sample=本地样本(默认,离线可跑/演示)
#            | fastmoss=FastMoss($0.01/次起,含JP) | socialcrawl=SocialCrawl(100免费额度,1credit/次,含JP)
#            | tikhub=TikHub($0.001/次起,评论含JP) | direct=直连RPA(默认不可用)
PRODUCT_SOURCE=sample
# 货源数据源：sample=家纺货源样本(默认,找家纺风格) | jiafang=找家纺网直连(免费,真实API) | 1688=综合批发平台直连(可选) | api=开放平台
SUPPLIER_SOURCE=sample
# 直连目标（source=jiafang / 1688 / direct 时使用）
TIKTOK_BASE_URL=https://www.tiktok.com
SUPPLIER_BASE_URL=https://www.1688.com
# 找家纺网（默认货源平台；原 91家纺网已替换）
JIAFANG_BASE_URL=https://www.zhaojiafang.com
# 找家纺搜索 API（前后端分离，数据 JSON 返回）
JIAFANG_API_BASE_URL=https://api-pl-mobile.zhaojiafang.com
# 找家纺商品详情站
JIAFANG_DETAIL_BASE_URL=https://detail.zhaojiafang.com
# 找家纺官方"以图搜款"token（F12 抓取，见 docs/RUN_GUIDE.md；过期需替换）
ZHAOJIAFANG_IMAGE_SEARCH_TOKEN=
# 代理（直连日本站建议日本住宅代理；留空不用），形如 http://user:pass@host:port
PROXY_URL=

# 第三方 TikTok Shop 数据平台 —— FastMoss OpenAPI（source=fastmoss 时必填）
# 申请：注册 https://openapi.fastmoss.com → Console 创建 client_secret → 按量充值
# 计费：$0.01/次起，pagesize>10 按 ceil(pagesize/10) 扣额度，空结果不计费
# 操作手册：docs/HOW_TO_GET_DATA.md
THIRD_PARTY_PRODUCT_API_BASE=https://openapi.fastmoss.com
THIRD_PARTY_PRODUCT_API_KEY=
# FastMoss 查询区域（JP=日本站；其它支持区域见 crawlers/fastmoss.py）
FASTMOSS_REGION=JP

# SocialCrawl（source=socialcrawl 时必填；免费 100 credits 验证真实数据链路）
# 注册：https://www.socialcrawl.dev → Dashboard 生成 x-api-key（无信用卡）
# 计费：每个端点 1 credit/次；缓存命中 0 credits；空结果/失败自动退款
SOCIALCRAWL_BASE_URL=https://www.socialcrawl.dev
SOCIALCRAWL_API_KEY=

# TikHub（source=tikhub 时必填；日常批量付费源）
# 注册：https://tikhub.io → user.tikhub.io/dashboard/api 生成 Bearer Token（新号送 $0.05）
# 计费：$0.001/次起，量大 30k+/天低至 $0.0005/次
# 注意：评论 V2 官方区域含 JP；搜索 V1/V2 官方区域未列 JP（日本站搜索建议 socialcrawl/fastmoss）
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_API_KEY=

# 国内货源平台（1688 开放平台/采购 API；source=api 时必填）
THIRD_PARTY_SUPPLIER_API_BASE=
THIRD_PARTY_SUPPLIER_API_KEY=

# ===== 日志级别 =====
LOG_LEVEL=INFO

# =====================================================================
# 【方案 B：只用一家】如果对话和向量都用硅基流动（有免费对话模型），
#   把上面 LLM_EMBEDDING_API_KEY / LLM_EMBEDDING_BASE_URL 两行删掉或留空，
#   并把对话三行改成：
#   LLM_API_KEY=sk-硅基流动的key
#   LLM_BASE_URL=https://api.siliconflow.cn/v1
#   LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#
# 【方案 C：用 OpenAI 官方】
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#   LLM_EMBEDDING_MODEL=text-embedding-3-small
#   MILVUS_EMBEDDING_DIM=1536
# =====================================================================
